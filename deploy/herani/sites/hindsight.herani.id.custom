limit_req_status 429;             # recorder stops on 429
access_log /var/log/nginx/replay.access.log replay;     # fase I4: tokens as <token> (log_format in replay-zones.conf)

proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header CF-Connecting-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto https;

location /i/ {
    limit_req zone=replay_ingest burst=40 nodelay;
    proxy_pass http://127.0.0.1:3930;
    # proxy_set_header here replaces the server-level list, so repeat it
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header CF-IPCountry $http_cf_ipcountry;
    proxy_set_header Origin $http_origin;
    proxy_request_buffering on;       # body read fully (≤ 1 MB) before it is passed on
    proxy_read_timeout 15s;
}

location /admin/api/ {
    limit_req zone=replay_admin burst=30 nodelay;
    proxy_pass http://127.0.0.1:3930;
    proxy_read_timeout 60s;           # /events of large sessions
}

# fase I3: read API for integrator servers (secret key). Own zone per key, never replay_ingest /
# replay_admin. Server-level proxy_set_header list applies (none set here).
location /api/v1/ {
    limit_req zone=replay_apikey burst=20 nodelay;
    proxy_pass http://127.0.0.1:3930;
    proxy_read_timeout 120s;          # /events of large sessions, streamed
}

# fase I4: public share data (/s/:token and /embed/:token pages go through "location /").
# Same zone as the dashboard: a viewer loads one page = 2 requests.
location /api/share/ {
    limit_req zone=replay_admin burst=30 nodelay;
    proxy_pass http://127.0.0.1:3930;
    proxy_read_timeout 60s;           # /events of large sessions
}

# fase I4: import, the only /api/v1 route with a body: 4 MB as sent (the app checks 4 MB / 20 MB
# after gunzip too), synchronous (20 MB takes ~2 s).
location = /api/v1/sessions/import {
    limit_req zone=replay_apikey burst=20 nodelay;
    client_max_body_size 4m;
    proxy_pass http://127.0.0.1:3930;
    proxy_read_timeout 60s;
}

location / {
    proxy_pass http://127.0.0.1:3930;
}
