absolute_redirect off;   # behind Cloudflare the browser is on https; keep redirects relative

add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
add_header X-Frame-Options SAMEORIGIN always;

gzip_types text/css application/javascript image/svg+xml application/json;

# Server Manager moved to https://monitor.herani.id (2026-10-25).
location ~ ^/server-manager(/.*)?$ {
    return 301 https://monitor.herani.id$1$is_args$args;
}

# Legacy shortlinks (herani.id/stock/<code>) go to the shortlink app (link.herani.id), not to
# herani-page's own /stock handler. Proxied, not redirected, so the app can tag the click as legacy.
location ~ "^/stock/([A-Za-z0-9_-]{1,64})$" {
    proxy_pass http://127.0.0.1:3920/$1$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Host link.herani.id;
    proxy_set_header Connection "";
    proxy_set_header CF-Connecting-IP $remote_addr;   # real visitor IP for click stats
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Shortlink-Legacy 1;
}
