# Template for scripts/install.sh, which replaces the @…@ values and installs the result as
# /etc/systemd/system/server-manager.service. Re-running the installer rewrites that file, so put
# your own settings (SM_BASE_PATH, SM_PUBLIC_URL, …) in a drop-in: sudo systemctl edit server-manager
#
# Runs as root so it can write systemd units, nginx config and app folders. The apps themselves
# do not: each runs as its own user (Run as, default @RUN_AS@). A dashboard login is therefore
# root on this server: keep HOST on 127.0.0.1 and reach it through an SSH tunnel or nginx + HTTPS.
[Unit]
Description=Server Manager (deploy, env, PostgreSQL, nginx, usage)
After=network-online.target postgresql.service nginx.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@DATA@
ExecStart=@BIN@
Environment=HOME=/root
Environment=HOST=127.0.0.1
Environment=PORT=@PORT@
Environment=SM_DATA_DIR=@DATA@
Environment=SM_APPS_DIR=@APPS@
Environment=SM_WEB_DIST=@WEB@
Environment=SM_DEFAULT_RUN_AS=@RUN_AS@
Environment=SM_BACKUP_DIR=@DATA@/backups/postgres
Environment=SM_NGINX_DIR=@NGINX_DIR@
Environment=SM_PUBLIC_IP=@PUBLIC_IP@
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
